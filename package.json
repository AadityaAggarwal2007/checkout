{
  "name": "checkout",
  "private": true,
  "version": "0.1.0",
  "description": "Cart drawer + one-page checkout for Shopify stores (multi-store).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
