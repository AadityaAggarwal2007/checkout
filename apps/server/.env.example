# Copy to .env (never commit .env). Values here are placeholders.
NODE_ENV=development
PORT=5002
# Public base URL of this server (used in OAuth redirects, gateway callbacks, the checkout iframe).
PUBLIC_URL=http://localhost:5002
# Dashboard origin (CORS + cookie redirects).
DASHBOARD_URL=http://localhost:5003
DATABASE_URL=postgresql://checkout:checkout@localhost:5432/checkout_dev
# 32+ random bytes, base64. Signs dashboard login tokens.
JWT_SECRET=
# Encryption keyring for stored secrets: "<keyId>:<base64 32-byte key>" — first one encrypts, all decrypt.
# Rotate by putting a new key first. Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=
# Pepper for hashing phone numbers / OTP codes (base64, 32 bytes).
HASH_PEPPER=
# Shopify app (Partner dashboard > App > Client credentials).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_orders,read_orders,read_customers,write_customers,read_discounts,read_themes
SHOPIFY_API_VERSION=2025-01
# 'dev' = use the local test store's products (apps/devstore/catalog.json), no Shopify needed.
CATALOG=shopify
DEV_CATALOG_FILE=../devstore/catalog.json
# Built storefront script and checkout page.
STOREFRONT_DIST=../storefront/dist/loader.js
CHECKOUT_DIST=../checkout/dist
# WhatsApp OTP (Meta Cloud API). 'dev' prints codes in the server log; production must be 'whatsapp'.
OTP_SENDER=dev
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_API_VERSION=v21.0
# Local only: '1' lets a store use the test gateway; 'dev' order sink sends orders to the local test store.
DEV_GATEWAY=0
ORDER_SINK=shopify
DEV_STORE_URL=http://localhost:5004
# Only when the browser reaches the test store at another address than this server does (Codespaces).
DEV_STORE_INTERNAL_URL=
# Pincode -> city/state autofill: india_post | dev | off
PINCODE_LOOKUP=india_post
