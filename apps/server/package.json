{
  "name": "@checkout/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "seed:dev": "tsx --env-file=.env scripts/seed-dev.ts"
  },
  "dependencies": {
    "@checkout/core": "*",
    "@checkout/shared": "*",
    "@fastify/cookie": "9.4.0",
    "@fastify/cors": "9.0.1",
    "@fastify/rate-limit": "9.1.0",
    "@prisma/client": "5.22.0",
    "fastify": "4.28.1",
    "jose": "5.9.6",
    "tsx": "4.19.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "prisma": "5.22.0"
  }
}
