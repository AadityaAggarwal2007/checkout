{
  "name": "@checkout/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Settings schemas (zod) and API types shared by server, dashboard, storefront and checkout.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@checkout/core": "*",
    "zod": "3.23.8"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./india": "./src/india.ts",
    "./payments": "./src/payments.ts",
    "./coupon-text": "./src/coupon-text.ts"
  }
}
